# Copy this file to .env and fill it in. NEVER upload .env to GitHub (it's in .gitignore).

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Optional: your server's ID. Makes slash commands appear instantly.
GUILD_ID=

# ---- AI (optional, add one or both) ----
# Claude: https://console.anthropic.com  > API Keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com  > API keys
OPENAI_API_KEY=

# Models to use. Change these if you want a smarter (pricier) or cheaper model.
CLAUDE_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5.4-mini

# Max length of each AI answer (higher = longer answers, more cost)
AI_MAX_OUTPUT_TOKENS=1000
