# Copy this file to .env and fill it in. NEVER upload .env to GitHub (it's in .gitignore).

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# ---- Developer setup (optional) ----
# You (the bot's owner in the Developer Portal) are detected automatically. Add DEV_IDS only for teammates.
# Your Discord user ID (right-click your name > Copy User ID). Add teammates with commas: 123,456
DEV_IDS=
# Optional extra server for /owner commands (servers you own get them automatically)
DEV_GUILD_ID=
# A private channel in your server for join/leave alerts and error reports
BOT_LOG_CHANNEL_ID=

# ---- Server authorization ----
# true = the bot only works in servers you approve (you get a DM with Approve/Deny buttons)
REQUIRE_AUTH=true
# Prefix for your hidden owner commands (,help)
OWNER_PREFIX=,

# ---- Optional ----
# Invite link to your support server (shows a button in /help, /invite, /about)
SUPPORT_URL=
# Change the bot's display name used in messages
BOT_NAME=Midtown Desk
